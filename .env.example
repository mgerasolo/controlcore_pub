# Example environment variables for the ControlCore suite
# Copy this file to .env and fill in real values

# PostgreSQL configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=
PG_PASSWORD=

# Individual database users
CONTROLCORE_USER=
CONTROLCORE_PW=
OPENHIST_USER=
OPENHIST_PW=
OPENFORE_USER=
OPENFORE_PW=

# MQTT broker settings
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=controlcore/#

# Control AI master script intervals (in minutes)
ADVISOR_INTERVAL_MINUTES=60
FORECAST_REGRESSION_INTERVAL_MINUTES=1440
